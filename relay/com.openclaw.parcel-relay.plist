<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.openclaw.parcel-relay</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/usr/local/lib/openclaw-parcel/relay/relay.mjs</string>
    <string>/usr/local/etc/openclaw-parcel/relay.config.json</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/usr/local/var/log/openclaw-parcel-relay.log</string>
  <key>StandardErrorPath</key><string>/usr/local/var/log/openclaw-parcel-relay.err.log</string>
</dict>
</plist>
